#!/usr/bin/env bash
set -euo pipefail

dbox_proxy="$HOME/.ssh/applied-devbox.d/dbox-proxy"
dbox_args=(--cluster devbox-3 --namespace oai-isaact)
brix_ssh=(
  brix --quiet ssh --no-wait
  -c fleet-research-agent-hub-0 -n isaact codex-box-0 --
  -T -o BatchMode=yes -o ConnectTimeout=15
)

cert_tmp=$(mktemp -d)
trap 'rm -rf "$cert_tmp"' EXIT

# Renew the Mac's certificate for the Applied tunnel when needed.
"$dbox_proxy" "${dbox_args[@]}" _ensure-ssh-certificate applied applied

# Brix has its own key for Nix's SSH connection through the relay.
"${brix_ssh[@]}" 'cat ~/.ssh/id_rsa.pub' > "$cert_tmp/brix.pub"
"$dbox_proxy" "${dbox_args[@]}" --ssh-public-key-file "$cert_tmp/brix.pub" \
  _ensure-ssh-certificate applied-brix applied

"${brix_ssh[@]}" \
  'umask 077; cat > ~/.ssh/id_rsa-cert.pub.new && mv ~/.ssh/id_rsa-cert.pub.new ~/.ssh/id_rsa-cert.pub' \
  < "$HOME/.ssh/applied-devbox.d/cert.applied-brix.dev3.pub"
